LLM_MODEL=mock
# Docker Compose settings. Local service examples live in chat/ and firewall/.
FIREWALL_TIMEOUT_SECONDS=130

# Agent identity the demo chat presents to the firewall (must exist in the Policy).
AGENT_KEY=demo-agent-key

# Firewall
OLLAMA_API_BASE=http://host.docker.internal:11434/v1
UPSTREAM_TIMEOUT_SECONDS=60

# Postgres (Audit Events)
POSTGRES_USER=firewall
POSTGRES_PASSWORD=firewall
POSTGRES_DB=firewall

# Host ports (change if they are already in use on your machine)
CHAT_PORT=8000
FIREWALL_PORT=8001

# Empty disables telemetry; full OTLP/HTTP traces endpoint.
TELEMETRY_OTLP_ENDPOINT=
TELEMETRY_PROJECT=ai-control-layer

# Tool runs: disable Ollama thinking for responsive demos; default keeps model settings.
OLLAMA_TOOL_REASONING_EFFORT=none

# Claude models (provider: anthropic). Read by the firewall only; empty = Claude calls fail closed.
ANTHROPIC_API_KEY=
